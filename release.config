#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────
# release.config — Edit this once per project
# ─────────────────────────────────────────────────────────

# ── App identity ──────────────────────────────────────────
APP_NAME="My Awesome App"
ANDROID_PACKAGE="com.example.myapp"
IOS_BUNDLE_ID="com.example.myapp"

# ── Build settings ────────────────────────────────────────
# "apk" or "appbundle" (appbundle recommended for Play Store)
ANDROID_BUILD_TYPE="appbundle"

# Extra flags passed to `flutter build` (e.g. --flavor prod)
FLUTTER_BUILD_FLAGS=""

# ── What's New file ───────────────────────────────────────
# Path to your changelog markdown file (the <lang>...</lang> format).
# The script reads the current version from pubspec.yaml, finds
# the matching entry in this file, and extracts per-language text.
# If a version has no text for a language, it walks backwards to
# find the most recent entry for that language.
WHATS_NEW_FILE="app-whats-new.md"

# Language tags used in your What's New file → store locale codes.
# Format: "file_tag:play_store_locale:app_store_locale"
# The script reads <file_tag>...</file_tag> blocks from the file
# and maps them to the correct store locale for upload.
LANGUAGE_MAP=(
  "uk:uk:uk"
  "en-US:en-US:en-US"
  "ru-RU:ru-RU:ru"
)

# ── Store listing (optional) ──────────────────────────────
# Only read by --metadata / --screenshots. Leave it unset and those flags are
# refused; a plain ./release.sh never touches your listing either way.
#
# One folder per LANGUAGE_MAP file tag, holding any of:
#   name.txt         subtitle.txt           keywords.txt
#   description.txt  short_description.txt  promotional_text.txt
#   eula.txt         screenshots/*.png
#
# A file you don't provide is not sent and the store keeps what it has, so a
# partial tree is safe. name also feeds Play's title, description also feeds
# Play's full description, and eula.txt is appended to the iOS description.
# Screenshots upload in filename order — number them.
#
# LISTING_DIR="metadata"

# Locales that ship another locale's screenshots, as "<tag>:<source tag>".
# SCREENSHOT_ALIAS=( "ru-RU:uk" )

# After uploading iOS screenshots, read the spread back from App Store Connect
# and repair it. deliver verifies its uploads against an eventually-consistent
# listing, so it reports screenshots that landed fine as missing, uploads them
# twice on the retry, and drops the tail of the spread against Apple's limit of
# 10 per device — all while exiting 0. Costs ~25s when nothing is wrong.
# RECONCILE_SCREENSHOTS=false
# SCREENSHOT_SETTLE_TIMEOUT=300

# ── Paths ─────────────────────────────────────────────────
PUBSPEC="pubspec.yaml"

# ── Android / Google Play ─────────────────────────────────
# Path to your Google Play service account JSON key.
PLAY_STORE_KEY="keys/play-store-key.json"

# Release track: "internal", "alpha", "beta", or "production"
PLAY_STORE_TRACK="production"

# ── iOS / App Store ───────────────────────────────────────
# App Store Connect API key (recommended over password auth).
ASC_KEY_ID=""
ASC_ISSUER_ID=""
ASC_KEY_FILE="keys/AuthKey.p8"

# ── Git tagging ───────────────────────────────────────────
GIT_TAG_RELEASES=true
GIT_PUSH_TAG=true
